{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "repos,issues,pull_requests,labels",
        "X-MCP-Readonly": "true"
      }
    },
    "ado_microsofthealthoss": {
      "command": "npx",
      "args": [
        "--registry",
        "https://registry.npmjs.org",
        "-y",
        "@azure-devops/mcp",
        "microsofthealthoss"
      ]
    }
  }
}
