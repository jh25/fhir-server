# Copy to .env and adjust.
# DEMO_TARGET=local → pre-demo (FHIR :8080, SQL :1433)
# DEMO_TARGET=dev   → post-demo (FHIR :8081, SQL :1434)
# WORKLIST_BACKEND=sql|fhir — which dependency the worklist uses (switch skills read this).
DEMO_TARGET=local
WORKLIST_BACKEND=sql
FHIR_BASE_URL=http://localhost:8080
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=FHIR
SQL_USER=sa
SQL_PASSWORD=L0cal-Dev-Pwd1
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true
PORT=3000
